<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= Table.TableName %> | Meta | DynamoDB</title>
    <%- include('partials/head') %>
    <%- include('partials/ace-deps') %>
</head>

<body class="min-h-full flex flex-col px-0 py-0 bg-slate-50 dark:bg-slate-950">
    <%
        const indexesUrl = `/tables/${encodeURIComponent(Table.TableName)}/indexes`;
    %>
    <%- include('partials/header', {
        breadcrumb: [
            { text: 'Tables', url: '/' },
            { text: Table.TableName, active: true }
        ],
        tabs: [
            { text: 'Items', url: `/tables/${encodeURIComponent(Table.TableName)}`, active: false },
            { text: 'Get', url: `/tables/${encodeURIComponent(Table.TableName)}/get`, active: false },
            { text: 'Meta', url: `/tables/${encodeURIComponent(Table.TableName)}/meta`, active: true }
        ],
        actions: `
            <div class="relative" id="actions-dropdown">
                <button type="button" id="actions-toggle" class="inline-flex items-center px-3 py-1.5 rounded bg-slate-200 dark:bg-slate-700 hover:bg-slate-300 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-300 text-xs font-bold transition-all">
                    <i data-lucide="settings" class="w-3.5 h-3.5 mr-1.5"></i>
                    ACTIONS
                    <i data-lucide="chevron-down" class="w-3.5 h-3.5 ml-1"></i>
                </button>
                <div id="actions-menu" class="hidden absolute right-0 mt-2 w-44 bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg shadow-lg overflow-hidden z-50">
                    <a href="${indexesUrl}" class="w-full px-4 py-2.5 text-left text-sm hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-2 transition-colors text-slate-700 dark:text-slate-300 no-underline">
                        <i data-lucide="list-tree" class="w-4 h-4"></i>
                        <span>Manage Indexes</span>
                    </a>
                    <div class="border-t border-slate-200 dark:border-slate-700"></div>
                    <button type="button" id="purgeTable" class="w-full px-4 py-2.5 text-left text-sm hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-2 transition-colors text-amber-600 dark:text-amber-400">
                        <i data-lucide="eraser" class="w-4 h-4"></i>
                        <span>Purge Data</span>
                    </button>
                    <button type="button" id="deleteTable" class="w-full px-4 py-2.5 text-left text-sm hover:bg-slate-100 dark:hover:bg-slate-700 flex items-center gap-2 transition-colors text-red-600 dark:text-red-400">
                        <i data-lucide="trash-2" class="w-4 h-4"></i>
                        <span>Delete Table</span>
                    </button>
                </div>
            </div>
        `
    }) %>

    <main class="grow flex flex-col mx-auto w-full px-4 py-6 mt-18">
        <%- include('partials/error-container') %>

        <div class="flex items-center justify-between mb-3 px-1">
            <div class="flex items-center space-x-2">
                <div class="w-1 h-4 bg-blue-500 dark:bg-blue-400 rounded-full"></div>
                <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mono">Table Definition (Read-Only)</span>
            </div>
        </div>

        <!-- Ace Editor Container -->
        <div class="grow relative min-h-125 mb-4" id="documentWrapper">
            <div id="documentArea"><%= JSON.stringify(Table, null, 2) %></div>
        </div>
    </main>

    <%- include('partials/confirmation-modal') %>

    <script>
        lucide.createIcons();

        // Actions dropdown toggle
        const actionsToggle = document.querySelector('#actions-toggle');
        const actionsMenu = document.querySelector('#actions-menu');

        if (actionsToggle && actionsMenu) {
            actionsToggle.addEventListener('click', (e) => {
                e.stopPropagation();
                actionsMenu.classList.toggle('hidden');
                lucide.createIcons();
            });

            // Close menu when clicking outside
            document.addEventListener('click', (e) => {
                if (!actionsMenu.contains(e.target) && !actionsToggle.contains(e.target)) {
                    actionsMenu.classList.add('hidden');
                }
            });
        }

        const editor = ace.edit("documentArea");
        editor.resize();
        editor.getSession().setMode("ace/mode/json");
        editor.setTheme("ace/theme/monokai");
        editor.setReadOnly(true);
        editor.setFontSize(14);
        editor.setOptions({
            showPrintMargin: false,
            highlightActiveLine: false,
            cursorStyle: "hide",
            useSoftTabs: true,
            tabSize: 2
        });

        // Purge Logic
        document.querySelector('#purgeTable').addEventListener('click', () => {
            actionsMenu.classList.add('hidden');
            purgeTable('<%= Table.TableName %>');
        });

        // Delete Logic
        document.querySelector('#deleteTable').addEventListener('click', () => {
            actionsMenu.classList.add('hidden');
            deleteTable('<%= Table.TableName %>', '/');
        });
    </script>

    <%- include('partials/confirmation-modal-script') %>
</body>

</html>
