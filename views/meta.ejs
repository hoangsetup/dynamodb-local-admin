<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= Table.TableName %> | Meta | DynamoDB</title>
    <%- include('partials/head') %>
    <%- include('partials/ace-deps') %>
</head>

<body class="min-h-full flex flex-col px-0 py-0 bg-slate-50 dark:bg-slate-950">
    <%- include('partials/header', {
        breadcrumb: [
            { text: 'Tables', url: '/' },
            { text: Table.TableName, active: true, badge: Table.ItemCount }
        ],
        tabs: [
            { text: 'Items', url: `/tables/${encodeURIComponent(Table.TableName)}`, active: false },
            { text: 'Get', url: `/tables/${encodeURIComponent(Table.TableName)}/get`, active: false },
            { text: 'Meta', url: `/tables/${encodeURIComponent(Table.TableName)}/meta`, active: true }
        ],
        tableActions: Table.TableName
    }) %>

    <main class="grow flex flex-col mx-auto w-full px-4 py-6 mt-18">
        <%- include('partials/error-container') %>

        <div class="flex items-center justify-between mb-3 px-1">
            <div class="flex items-center space-x-2">
                <div class="w-1 h-4 bg-blue-500 dark:bg-blue-400 rounded-full"></div>
                <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mono">Table Definition (Read-Only)</span>
            </div>
        </div>

        <!-- Ace Editor Container -->
        <div class="grow relative min-h-125 mb-4" id="documentWrapper">
            <div id="documentArea"><%= JSON.stringify(Table, null, 2) %></div>
        </div>
    </main>

    <%- include('partials/confirmation-modal') %>

    <script>
        lucide.createIcons();

        const editor = ace.edit("documentArea");
        editor.resize();
        editor.getSession().setMode("ace/mode/json");
        editor.setTheme("ace/theme/monokai");
        editor.setReadOnly(true);
        editor.setFontSize(14);
        editor.setOptions({
            showPrintMargin: false,
            highlightActiveLine: false,
            cursorStyle: "hide",
            useSoftTabs: true,
            tabSize: 2
        });
    </script>

    <%- include('partials/table-actions-script', { tableName: Table.TableName }) %>
    <%- include('partials/confirmation-modal-script') %>
</body>

</html>
