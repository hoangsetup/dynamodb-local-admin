<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= Table.TableName %> | Meta | DynamoDB</title>
    <%- include('partials/head') %>
    <%- include('partials/ace-deps') %>
</head>

<body class="min-h-full flex flex-col px-0 py-0 bg-slate-50 dark:bg-slate-950">

    <%- include('partials/header', {
        breadcrumb: [
            { text: 'Tables', url: '/' },
            { text: Table.TableName, active: true }
        ],
        tabs: [
            { text: 'Items', url: `/tables/${encodeURIComponent(Table.TableName)}`, active: false },
            { text: 'Get', url: `/tables/${encodeURIComponent(Table.TableName)}/get`, active: false },
            { text: 'Meta', url: `/tables/${encodeURIComponent(Table.TableName)}/meta`, active: true }
        ],
        actions: `
            <button type="button" id="purgeTable" class="inline-flex items-center px-3 py-1.5 rounded bg-amber-600/10 dark:bg-amber-600/20 hover:bg-amber-600 text-amber-600 dark:text-amber-400 hover:text-white text-xs font-bold border border-amber-600/30 dark:border-amber-600/40 transition-all">
                <i data-lucide="eraser" class="w-3.5 h-3.5 mr-1.5"></i>
                PURGE DATA
            </button>
            <button type="button" id="deleteTable" class="inline-flex items-center px-3 py-1.5 rounded bg-red-600/10 dark:bg-red-600/20 hover:bg-red-600 text-red-600 dark:text-red-400 hover:text-white text-xs font-bold border border-red-600/30 dark:border-red-600/40 transition-all">
                <i data-lucide="trash-2" class="w-3.5 h-3.5 mr-1.5"></i>
                DELETE
            </button>
        `
    }) %>

    <main class="flex-grow flex flex-col mx-auto w-full px-4 py-6 mt-[72px]">
        <%- include('partials/error-container') %>

        <div class="flex items-center justify-between mb-3 px-1">
            <div class="flex items-center space-x-2">
                <div class="w-1 h-4 bg-blue-500 dark:bg-blue-400 rounded-full"></div>
                <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mono">Table Definition (Read-Only)</span>
            </div>
        </div>

        <!-- Ace Editor Container -->
        <div class="flex-grow relative min-h-[500px] mb-4" id="documentWrapper">
            <div id="documentArea"><%= JSON.stringify(Table, null, 2) %></div>
        </div>
    </main>

    <%- include('partials/confirmation-modal') %>

    <script>
        lucide.createIcons();

        const editor = ace.edit("documentArea");
        editor.resize();
        editor.getSession().setMode("ace/mode/json");
        editor.setTheme("ace/theme/monokai");
        editor.setReadOnly(true);
        editor.setFontSize(14);
        editor.setOptions({
            showPrintMargin: false,
            highlightActiveLine: false,
            cursorStyle: "hide",
            useSoftTabs: true,
            tabSize: 2
        });

        // Purge Logic
        document.querySelector('#purgeTable').addEventListener('click', () => {
            purgeTable('<%= Table.TableName %>');
        });

        // Delete Logic
        document.querySelector('#deleteTable').addEventListener('click', () => {
            deleteTable('<%= Table.TableName %>', '/');
        });
    </script>

    <%- include('partials/confirmation-modal-script') %>
</body>

</html>
