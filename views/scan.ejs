<%
/** @typedef {import('@aws-sdk/client-dynamodb').TableDescription} TableDescription */
/** @typedef {import('@aws-sdk/client-dynamodb').TimeToLiveDescription} TimeToLiveDescriptionType */
/**
 * @name query
 * @type {{[key: string]: string }}
 */
/**
 * @name pageNum
 * @type {number}
 */
/**
 * @name operators
 * @type {Object<string, string>}
 */
/**
 * @name attributeTypes
 * @type {Object<string, string>}
 */
/**
 * @name Table
 * @type {TableDescription}
 */
/**
 * @name TimeToLiveDescription
 * @type {TimeToLiveDescriptionType}
 */
%>
<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= Table.TableName %> | Items | DynamoDB</title>
    <%- include('partials/head') %>
    <script src='/assets/vendor/json-formatter/json-formatter.js'></script>
</head>

<body class="min-h-full flex flex-col bg-slate-50 dark:bg-slate-950">

    <%- include('partials/header', {
        breadcrumb: [
            { text: 'Tables', url: '/' },
            { text: Table.TableName, active: true }
        ],
        tabs: [
            { text: 'Items', url: `/tables/${encodeURIComponent(Table.TableName)}`, active: true },
            { text: 'Get', url: `/tables/${encodeURIComponent(Table.TableName)}/get`, active: false },
            { text: 'Meta', url: `/tables/${encodeURIComponent(Table.TableName)}/meta`, active: false }
        ],
        actions: `
            <a href="/tables/${encodeURIComponent(Table.TableName)}/add-item" class="inline-flex items-center px-3 py-1.5 rounded bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold shadow-lg transition-all">
                <i data-lucide="plus-circle" class="w-3.5 h-3.5 mr-1.5"></i>
                CREATE ITEM
            </a>
        `
    }) %>

    <main class="grow mx-auto w-full px-4 py-4 mt-18">
        <%- include('partials/error-container') %>

        <!-- Filter/Search Controls Card - COMPACT VERSION -->
        <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-lg shadow-sm overflow-hidden mb-4">
            <div class="px-4 py-2 bg-slate-50 dark:bg-slate-900 border-b border-slate-200 dark:border-slate-700 flex justify-between items-center cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" onclick="toggleFilterPanel()">
                <div class="flex items-center space-x-2">
                    <i data-lucide="filter" class="w-3 h-3 text-blue-500 dark:text-blue-400"></i>
                    <span class="text-[10px] font-bold text-slate-500 dark:text-slate-400 uppercase tracking-widest mono">Scan / Query</span>
                </div>
                <i id="filter-toggle-icon" data-lucide="chevron-down" class="w-4 h-4 text-slate-400 dark:text-slate-500 transition-transform"></i>
            </div>

            <form id="form" method="get" action="/tables/<%= encodeURIComponent(Table.TableName) %>" class="p-4 hidden">
                <datalist id="attributes">
                    <% for (let AttributeDefinition of Table.AttributeDefinitions) { %>
                        <option value="<%= AttributeDefinition.AttributeName %>"></option>
                    <% } %>
                </datalist>

                <div class="flex flex-wrap items-end gap-3 mb-4">
                    <div class="w-32">
                        <label class="block text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1 mono">Operation</label>
                        <select name="operationType" class="select">
                            <option value="scan" <% if (query.operationType === 'scan') { %> selected <% } %>>Scan</option>
                            <option value="query" <% if (query.operationType === 'query') { %> selected <% } %>>Query</option>
                        </select>
                    </div>
                    <div class="grow min-w-50">
                        <label class="block text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-wider mb-1 mono">Index / Selection</label>
                        <select name="queryableSelection" class="select" <% if (!Table.GlobalSecondaryIndexes) { %> disabled <% } %>>
                            <option value="table"
                                <% Table.KeySchema.forEach(keySchemaItem => { %> data-key-<%= keySchemaItem.KeyType.toLowerCase() %>="<%= keySchemaItem.AttributeName %>" <% }) %>
                                <% if (query.queryableSelection === 'table') { %> selected <% } %>>
                                [Table] <%= Table.TableName %>
                            </option>
                            <% if (Table.GlobalSecondaryIndexes) { %>
                                <% for (const index of Table.GlobalSecondaryIndexes) { %>
                                    <% const attributes = index.KeySchema.map((keySchemaItem) => keySchemaItem.AttributeName) %>
                                    <option value="<%= index.IndexName %>"
                                        <% index.KeySchema.forEach(keySchemaItem => { %> data-key-<%= keySchemaItem.KeyType.toLowerCase() %>="<%= keySchemaItem.AttributeName %>" <% }) %>
                                        <% if (query.queryableSelection === index.IndexName) { %> selected <% } %>>
                                        [Index] <%= index.IndexName %>: <%= attributes.join(', ') %>
                                    </option>
                                <% } %>
                            <% } %>
                        </select>
                    </div>
                </div>

                <!-- Dynamic Filters - Single Line -->
                <div id="filters-container" class="space-y-2 border-t border-slate-100 dark:border-slate-700/50 pt-3">
                    <div class="filter-row flex items-center gap-2">
                        <input type="text" class="filter-row-key input w-48" placeholder="Attribute" list="attributes" />
                        <select class="filter-row-type select w-24">
                            <% for (const type in attributeTypes) { %>
                                <option value="<%= type %>"><%= attributeTypes[type] %></option>
                            <% } %>
                        </select>
                        <select class="filter-row-operator select w-28">
                            <% for (const operator in operators) { %>
                                <option value="<%= operator %>"><%= operators[operator] %></option>
                            <% } %>
                        </select>
                        <input type="text" class="filter-row-value input flex-1" placeholder="Value" />
                        <button type="button" onclick="removeFilter(this)" class="filter-remove shrink-0 flex items-center text-[10px] font-bold text-red-600 dark:text-red-400 hover:text-red-700 dark:hover:text-red-300 mono px-2 py-1.5 rounded border border-red-200 dark:border-red-900/40 bg-red-50/50 dark:bg-red-900/10 hover:bg-red-100 dark:hover:bg-red-900/20 transition-colors">
                            <i data-lucide="x" class="w-3 h-3 mr-1"></i> REMOVE
                        </button>
                    </div>
                </div>

                <div class="mt-2">
                    <button type="button" id="add-filter" class="flex items-center text-[10px] font-bold text-blue-500 dark:text-blue-400 hover:text-blue-600 dark:hover:text-blue-300 mono px-2 py-1.5 rounded border border-blue-100 dark:border-blue-900/40 bg-blue-50/50 dark:bg-blue-900/10">
                        <i data-lucide="plus" class="w-3 h-3 mr-1"></i> FILTER
                    </button>
                </div>

                <input id="filters" name="filters" type="hidden" />

                <div class="mt-4 pt-3 border-t border-slate-100 dark:border-slate-700 flex items-center justify-between">
                    <div class="flex items-center gap-2">
                        <button type="submit" class="bg-slate-800 dark:bg-blue-600 hover:bg-slate-900 dark:hover:bg-blue-500 text-white font-bold py-1.5 px-4 rounded shadow transition-all mono text-[11px] flex items-center">
                            <i data-lucide="play" class="w-3 h-3 mr-1.5"></i> RUN
                        </button>
                        <a href="/tables/<%= encodeURIComponent(Table.TableName) %>" class="bg-slate-100 dark:bg-slate-700 hover:bg-slate-200 dark:hover:bg-slate-600 text-slate-700 dark:text-slate-200 font-bold py-1.5 px-4 rounded shadow transition-all mono text-[11px] flex items-center">
                            <i data-lucide="rotate-ccw" class="w-3 h-3 mr-1.5"></i> RESET
                        </a>
                    </div>
                    <div class="pagination-container flex items-center space-x-3">
                         <div class="flex items-center space-x-2">
                            <label class="text-[9px] font-bold text-slate-400 dark:text-slate-500 uppercase tracking-widest mb-0 mono">Limit</label>
                            <select name="pageSize" class="select">
                                <% for (const [i, size] of [25, 100, 250, 500, 1000, 3000, 10000].entries()) { %>
                                    <option value="<%= size %>" <% if (Number.parseInt(query.pageSize) === size || (!query.pageSize && i === 0)) { %> selected <% } %>><%= size %></option>
                                <% } %>
                            </select>
                        </div>
                        <div class="h-3 w-px bg-slate-200 dark:bg-slate-700"></div>
                        <nav class="flex items-center space-x-1">
                            <a class="page-link-previous disabled px-2 py-1 text-[9px] font-bold text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded border border-slate-200 dark:border-slate-700 mono transition-colors cursor-pointer">PREV</a>
                            <span class="px-2 py-1 text-[9px] font-bold text-blue-500 dark:text-blue-400 mono bg-blue-50 dark:bg-blue-900/20 rounded">Page <%= pageNum %></span>
                            <a class="page-link-next disabled px-2 py-1 text-[9px] font-bold text-slate-500 dark:text-slate-400 hover:bg-slate-100 dark:hover:bg-slate-800 rounded border border-slate-200 dark:border-slate-700 mono transition-colors cursor-pointer">NEXT</a>
                        </nav>
                    </div>
                </div>
            </form>
        </div>

        <!-- Table Loading State -->
        <div id="table-placeholder" class="py-12 flex flex-col items-center justify-center text-slate-400 dark:text-slate-500">
            <div class="animate-spin mb-3"><i data-lucide="loader-2" class="w-6 h-6"></i></div>
            <span class="mono text-[10px] uppercase tracking-widest">Fetching results...</span>
        </div>

        <!-- No Results -->
        <div class="no-results text-center py-16 hidden">
            <div class="mb-3 text-slate-300 dark:text-slate-600"><i data-lucide="file-x-2" class="w-12 h-12 mx-auto"></i></div>
            <h3 class="text-slate-700 dark:text-slate-300 text-sm font-medium mb-1">No Results Found</h3>
            <p class="text-slate-500 dark:text-slate-400 text-[10px] mono">Try adjusting your filters</p>
        </div>

        <!-- Results Table -->
        <div class="table-container hidden">
             <div class="items-table-wrapper relative bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 shadow-sm rounded-lg overflow-x-auto">
                <table class="w-full text-left text-sm border-collapse">
                    <thead class="bg-slate-50 dark:bg-slate-900/50">
                        <tr id="actions-row">
                        </tr>
                    </thead>
                    <tbody id="items-container">
                        <!-- Items populated via JS -->
                    </tbody>
                </table>
            </div>
        </div>
    </main>

    <script>
        /* global JSONFormatter */
        const JSONRender = value => new JSONFormatter.default(value, 1, { theme: document.documentElement.getAttribute('data-theme') ?? 'light' }).render()

        let currentSortColumn = null;
        let currentSortDirection = 'asc';
        let tableData = null;

        // Get key schema from Table
        const keySchema = {
            <% const hashKey = Table.KeySchema?.find(k => k.KeyType === 'HASH'); %>
            <% const rangeKey = Table.KeySchema?.find(k => k.KeyType === 'RANGE'); %>
            hashKey: '<%= hashKey?.AttributeName || '' %>',
            rangeKey: '<%= rangeKey?.AttributeName || '' %>'
        };

        const ttlAttributeName = '<%= TimeToLiveDescription.TimeToLiveStatus === 'ENABLED' ? TimeToLiveDescription.AttributeName : ''; %>';

        // Toggle filter panel
        function toggleFilterPanel() {
            const form = document.querySelector('#form');
            const icon = document.querySelector('#filter-toggle-icon');

            form.classList.toggle('hidden');

            // Rotate icon
            if (form.classList.contains('hidden')) {
                icon.setAttribute('data-lucide', 'chevron-down');
            } else {
                icon.setAttribute('data-lucide', 'chevron-up');
            }
            lucide.createIcons();
        }

        document.addEventListener('DOMContentLoaded', () => {
            lucide.createIcons();

            // Expand filter panel if there are query parameters
            if (location.search) {
                const form = document.querySelector('#form');
                const icon = document.querySelector('#filter-toggle-icon');
                form.classList.remove('hidden');
                icon.setAttribute('data-lucide', 'chevron-up');
                lucide.createIcons();
            }

            const form = document.querySelector('#form')
            form.addEventListener('submit', (e) => {
                const filters = {}
                document.querySelectorAll('#filters-container .filter-row').forEach((filterRow) => {
                    const keyField = filterRow.querySelector('.filter-row-key')
                    const typeField = filterRow.querySelector('.filter-row-type')
                    const operatorField = filterRow.querySelector('.filter-row-operator')
                    const valueField = filterRow.querySelector('.filter-row-value')

                    if (keyField.value && valueField.value) {
                        filters[keyField.value] = {
                            operator: operatorField.value,
                            value: valueField.value,
                            type: typeField.value,
                        }
                    }
                })
                form.filters.value = JSON.stringify(filters)
            })

            document.querySelector('select[name="queryableSelection"]').addEventListener('change', () => {
                if (document.querySelector('select[name="operationType"]').value === 'query') {
                    unrequireAllFilters();
                    requireIndexFilters();
                }
            });

            document.querySelector('select[name="operationType"]').addEventListener('change', (e) => {
                if (e.target.value === 'query') requireIndexFilters();
                else unrequireAllFilters();
            });

            document.querySelector('#add-filter').addEventListener('click', (e) => {
                e.preventDefault();
                addFilter();
            });

            function requireIndexFilters() {
                const select = document.querySelector('select[name="queryableSelection"]');
                const option = select.options[select.selectedIndex];
                const hashKey = option.dataset.keyHash;
                const rangeKey = option.dataset.keyRange;
                if (hashKey) addHashKeyFilter(hashKey);
                if (rangeKey) addRangeKeyFilter(rangeKey);
            }

            function unrequireAllFilters() {
                document.querySelectorAll('.filter-row').forEach(row => {
                    const keyField = row.querySelector('.filter-row-key');
                    keyField.required = false;
                    keyField.readOnly = false;
                    row.querySelector('.filter-row-value').required = false;
                    row.querySelector('.filter-remove').style.display = '';
                    const opField = row.querySelector('.filter-row-operator');
                    opField.disabled = false;
                    opField.querySelectorAll('option').forEach(opt => opt.disabled = false);
                });
            }

            function addFilter(key, values, required, availableOperators) {
                let filterRow;
                if (key) {
                    document.querySelectorAll('.filter-row').forEach(row => {
                        if (row.querySelector('.filter-row-key').value === key) filterRow = row;
                    });
                }

                if (!filterRow) {
                    const lastRow = document.querySelector('.filter-row');
                    filterRow = lastRow.cloneNode(true);
                    filterRow.querySelector('.filter-row-value').value = values?.value || '';
                    document.querySelector('#filters-container').appendChild(filterRow);
                }

                const keyField = filterRow.querySelector('.filter-row-key');
                keyField.value = key || '';

                if (required) {
                    keyField.required = true;
                    keyField.readOnly = true;
                    filterRow.querySelector('.filter-row-value').required = true;
                    filterRow.querySelector('.filter-remove').style.display = 'none';
                } else {
                    keyField.required = false;
                    keyField.readOnly = false;
                    filterRow.querySelector('.filter-row-value').required = false;
                    filterRow.querySelector('.filter-remove').style.display = '';
                }

                const typeField = filterRow.querySelector('.filter-row-type');
                if (values?.type) typeField.value = values.type;

                const opField = filterRow.querySelector('.filter-row-operator');
                if (values?.operator) opField.value = values.operator;

                opField.querySelectorAll('option').forEach(option => {
                    const enabled = availableOperators ? availableOperators.includes(option.value) : true;
                    option.disabled = !enabled;
                });

                if (availableOperators && !availableOperators.includes(opField.value)) {
                    opField.value = availableOperators[0];
                }
                opField.disabled = availableOperators?.length === 1;
                lucide.createIcons();
            }

            function addHashKeyFilter(hashKey, values) { addFilter(hashKey, values, true, ['=']); }
            function addRangeKeyFilter(rangeKey, values) { addFilter(rangeKey, values, false, ['=', '<', '<=', '>', '>=', 'BETWEEN', 'begins_with']); }

            window.removeFilter = function(node) {
                const filterRows = document.querySelectorAll('.filter-row');
                if (filterRows.length === 1) {
                    filterRows[0].querySelectorAll('input').forEach(input => input.value = '');
                } else {
                    node.closest('.filter-row').remove();
                }
            };

            window.sortTableByColumn = function(column) {
                if (currentSortColumn === column) {
                    currentSortDirection = currentSortDirection === 'asc' ? 'desc' : 'asc';
                } else {
                    currentSortColumn = column;
                    currentSortDirection = 'asc';
                }

                tableData.Items.sort((a, b) => {
                    const aVal = a[column];
                    const bVal = b[column];

                    // Handle null/undefined
                    if (aVal == null && bVal == null) return 0;
                    if (aVal == null) return 1;
                    if (bVal == null) return -1;

                    // Compare values
                    let comparison = 0;
                    if (typeof aVal === 'string' && typeof bVal === 'string') {
                        comparison = aVal.localeCompare(bVal);
                    } else if (typeof aVal === 'number' && typeof bVal === 'number') {
                        comparison = aVal - bVal;
                    } else {
                        comparison = String(aVal).localeCompare(String(bVal));
                    }

                    return currentSortDirection === 'asc' ? comparison : -comparison;
                });

                renderTableRows();
                updateSortIcons();
            }

            function updateSortIcons() {
                document.querySelectorAll('#actions-row th').forEach((th, index) => {
                    const column = tableData.uniqueKeys[index];
                    const iconSpan = th.querySelector('.sort-icon');
                    if (iconSpan) {
                        if (currentSortColumn === column) {
                            iconSpan.innerHTML = currentSortDirection === 'asc'
                                ? '<i data-lucide="arrow-up" class="w-3 h-3"></i>'
                                : '<i data-lucide="arrow-down" class="w-3 h-3"></i>';
                        } else {
                            iconSpan.innerHTML = '<i data-lucide="arrow-up-down" class="w-3 h-3"></i>';
                        }
                        lucide.createIcons();
                    }
                });
            }

            function renderTableRows() {
                const itemsContainer = document.querySelector('#items-container');
                itemsContainer.innerHTML = '';

                tableData.Items.forEach(item => {
                    const tr = document.createElement('tr');
                    tr.className = 'group transition-colors';

                    tableData.uniqueKeys.forEach((column, index) => {
                        const td = document.createElement('td');
                        if (index === 0) {
                            td.className = 'max-w-[50ch] sticky left-0 z-20 px-4 py-3 border-b border-b-slate-200 dark:border-b-slate-700 bg-white dark:bg-slate-800 group-hover:bg-slate-100 dark:group-hover:bg-slate-700 border-r border-r-slate-200 dark:border-r-slate-700 transition-colors';
                        } else {
                            td.className = 'px-4 py-3 border-b border-b-slate-200 dark:border-b-slate-700 bg-white dark:bg-slate-800 group-hover:bg-slate-100 dark:group-hover:bg-slate-700 transition-colors';
                        }
                        const value = item[column];
                        let wrapper = document.createElement('div');
                        let dateTooltip = null;

                        if (Number.isInteger(value)) {
                            let dateValue;
                            if (value >= 10000000000) {
                                const date = new Date(value);
                                if (!isNaN(date)) dateValue = `${date.toISOString()} (ms epoch)`;
                            } else if (value >= 100000000) {
                                const date = new Date(value * 1000);
                                if (!isNaN(date)) dateValue = `${date.toISOString()} (s epoch)`;
                            }
                            if (dateValue) {
                                dateTooltip = dateValue;
                                wrapper.className = 'relative group/tooltip';
                            }
                        }

                        if (index === 0) {
                            const viewUrl = '/tables/<%= encodeURIComponent(Table.TableName) %>/items/' + encodeURIComponent(Object.values(item.__key).join(','));
                            const div = JSONRender(value);
                            div.classList.add('truncate');
                            div.querySelector('span > span').className = 'json-formatter-string !text-blue-600 dark:!text-blue-400 underline underline-offset-2';
                            const link = document.createElement('a');
                            link.href = viewUrl;
                            link.className = 'truncate';
                            link.appendChild(div);
                            wrapper.appendChild(link);
                        } else {
                            const content = JSONRender(value);
                            if (dateTooltip) {
                                content.querySelector('.json-formatter-number').className = 'json-formatter-number cursor-help decoration-dotted underline-offset-4 underline text-blue-600 dark:text-blue-400';
                            }
                            wrapper.appendChild(content);

                            if (dateTooltip) {
                                const tooltip = document.createElement('div');
                                tooltip.className = 'absolute bottom-full left-1/2 -translate-x-1/2 mb-2 px-3 py-2 bg-slate-900 dark:bg-slate-700 text-white text-xs rounded-lg shadow-lg opacity-0 invisible group-hover/tooltip:opacity-100 group-hover/tooltip:visible transition-all duration-200 whitespace-nowrap z-50 pointer-events-none';
                                tooltip.textContent = dateTooltip;

                                const arrow = document.createElement('div');
                                arrow.className = 'absolute top-full left-1/2 -translate-x-1/2 -mt-1 border-4 border-transparent border-t-slate-900 dark:border-t-slate-700';
                                tooltip.appendChild(arrow);

                                wrapper.appendChild(tooltip);
                            }
                        }

                        td.appendChild(wrapper);
                        tr.appendChild(td);
                    });
                    itemsContainer.appendChild(tr);
                });
            }

            function renderItems(data) {
                tableData = data;
                const actionsRow = document.querySelector('#actions-row');
                actionsRow.insertAdjacentHTML('beforeend', data.uniqueKeys.map((key, index) => {
                    const keyLabel = key === keySchema.hashKey ? ' <span class="italic text-slate-500 dark:text-slate-600">(PK)</span>'
                                   : key === keySchema.rangeKey ? ' <span class="italic text-slate-500 dark:text-slate-600">(SK)</span>'
                                   : key === ttlAttributeName ? ' <span class="italic text-slate-500 dark:text-slate-600">(TTL)</span>'
                                   : '';
                    return index === 0
                        ? `<th scope="col" class="max-w-[50ch] sticky top-0 left-0 z-20 px-4 py-3 text-[14px] font-bold text-slate-400 mono border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 border-r border-r-slate-200 dark:border-r-slate-700 whitespace-nowrap cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" onclick="sortTableByColumn('${key}')">
                            <div class="flex items-center justify-between gap-2">
                                <span>${key}${keyLabel}</span>
                                <span class="sort-icon text-slate-400"><i data-lucide="arrow-up-down" class="w-3 h-3"></i></span>
                            </div>
                          </th>`
                        : `<th scope="col" class="sticky top-0 z-10 px-4 py-3 text-[14px] font-bold text-slate-400 mono border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900 whitespace-nowrap cursor-pointer hover:bg-slate-100 dark:hover:bg-slate-800 transition-colors" onclick="sortTableByColumn('${key}')">
                            <div class="flex items-center justify-between gap-2">
                                <span>${key}${keyLabel}</span>
                                <span class="sort-icon text-slate-400"><i data-lucide="arrow-up-down" class="w-3 h-3"></i></span>
                            </div>
                          </th>`
                }).join(''));
                lucide.createIcons();

                if (data.Items.length) {
                    renderTableRows();

                    const pageSize = document.querySelector('select[name="pageSize"]').value;
                    const prevLink = document.querySelector('.page-link-previous');
                    const nextLink = document.querySelector('.page-link-next');

                    if (data.pageNum > 1) {
                        prevLink.href = `?startKey=${data.prevKey}&pageNum=${data.pageNum - 1}&filters=${data.filterQueryString}&pageSize=${pageSize}`;
                        prevLink.classList.remove('disabled');
                        prevLink.classList.add('hover:text-blue-600', 'dark:hover:text-blue-400');
                    }
                    if (data.nextKey) {
                        nextLink.href = `?startKey=${data.nextKey}&prevKey=${data.prevKey}&pageNum=${data.pageNum + 1}&filters=${data.filterQueryString}&pageSize=${pageSize}`;
                        nextLink.classList.remove('disabled');
                        nextLink.classList.add('hover:text-blue-600', 'dark:hover:text-blue-400');
                    }

                    document.querySelector('.table-container').classList.remove('hidden');
                    document.querySelector('.pagination-container').classList.remove('hidden');
                } else {
                    document.querySelector('.no-results').classList.remove('hidden');
                }
                document.querySelector('#table-placeholder').classList.add('hidden');
            }

            const urlParams = new URLSearchParams(location.search);
            const queryStringFilters = urlParams.get('filters');

            if (queryStringFilters) {
                try {
                    const queryFilters = JSON.parse(decodeURIComponent(queryStringFilters));
                    const opType = document.querySelector('select[name="operationType"]').value;
                    Object.keys(queryFilters).forEach(fKey => {
                        const fParams = queryFilters[fKey];
                        if (opType === 'query') {
                            const select = document.querySelector('select[name="queryableSelection"]');
                            const opt = select.options[select.selectedIndex];
                            if (fKey === opt.dataset.keyHash) addHashKeyFilter(fKey, fParams);
                            else if (fKey === opt.dataset.keyRange) addRangeKeyFilter(fKey, fParams);
                            else addFilter(fKey, fParams);
                        } else addFilter(fKey, fParams);
                    });

                    // Remove empty filter rows, but keep at least one
                    const filterRows = document.querySelectorAll('.filter-row');
                    if (filterRows.length > 1) {
                        filterRows.forEach(row => {
                            const keyField = row.querySelector('.filter-row-key');
                            const valueField = row.querySelector('.filter-row-value');
                            if (!keyField.value && !valueField.value) {
                                row.remove();
                            }
                        });
                    }
                } catch (e) {}
            }

            fetch(document.location.pathname + '/items' + document.location.search)
                .then(r => r.ok ? r.json() : r.text().then(t => { throw new Error(JSON.parse(t).message) }))
                .then(renderItems)
                .catch(err => handleError(err.message));
        });
    </script>

</body>

</html>
