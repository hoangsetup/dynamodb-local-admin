<!DOCTYPE html>
<html lang="en" class="h-full">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= Table.TableName %> | Get Item | DynamoDB</title>
    <%- include('partials/head') %>
</head>

<body class="min-h-full flex flex-col bg-slate-50 dark:bg-slate-950">

    <%- include('partials/header', {
        breadcrumb: [
            { text: 'Tables', url: '/' },
            { text: Table.TableName, active: true }
        ],
        tabs: [
            { text: 'Items', url: `/tables/${encodeURIComponent(Table.TableName)}`, active: false },
            { text: 'Get', url: `/tables/${encodeURIComponent(Table.TableName)}/get`, active: true },
            { text: 'Meta', url: `/tables/${encodeURIComponent(Table.TableName)}/meta`, active: false }
        ],
        actions: `
            <a href="/tables/${encodeURIComponent(Table.TableName)}/add-item" class="inline-flex items-center px-3 py-1.5 rounded bg-blue-600 hover:bg-blue-500 text-white text-xs font-bold shadow-lg transition-all">
                <i data-lucide="plus-circle" class="w-3.5 h-3.5 mr-1.5"></i>
                CREATE ITEM
            </a>
        `
    }) %>

    <main class="flex-grow mx-auto w-full px-4 py-10 mt-[72px]">
        <%- include('partials/error-container') %>

        <div class="bg-white dark:bg-slate-800 border border-slate-200 dark:border-slate-700 rounded-xl shadow-sm overflow-hidden">
            <div class="px-6 py-4 border-b border-slate-200 dark:border-slate-700 bg-slate-50 dark:bg-slate-900/50 flex items-center justify-between">
                <div class="flex items-center space-x-2">
                    <i data-lucide="search" class="w-4 h-4 text-blue-500 dark:text-blue-400"></i>
                    <h2 class="text-sm font-bold text-slate-700 dark:text-slate-200 uppercase tracking-wider mono">Get Item by Key</h2>
                </div>
                <span class="text-[10px] font-bold text-slate-400 dark:text-slate-500 mono">POINT_READ_OPERATION</span>
            </div>

            <form id="form" autocomplete="off" class="p-6 space-y-6">
                <div class="grid gap-6">
                    <% if (hashKey) { %>
                        <div class="space-y-2">
                            <label class="label-sm">
                                <i data-lucide="key" class="w-3 h-3 mr-2 text-blue-500 dark:text-blue-400"></i>
                                Partition Key: <%= hashKey.AttributeName %>
                            </label>
                            <input autofocus
                                   type="text"
                                   name="hash"
                                   required
                                   placeholder="Enter <%= hashKey.AttributeName %> value..."
                                   class="input">
                        </div>
                    <% } %>

                    <% if (rangeKey) { %>
                        <div class="space-y-2">
                            <label class="label-sm">
                                <i data-lucide="layers" class="w-3 h-3 mr-2 text-purple-500 dark:text-purple-400"></i>
                                Sort Key: <%= rangeKey.AttributeName %>
                            </label>
                            <input type="text"
                                   name="range"
                                   required
                                   placeholder="Enter <%= rangeKey.AttributeName %> value..."
                                   class="input">
                        </div>
                    <% } %>
                </div>

                <div class="pt-4 border-t border-slate-100 dark:border-slate-700 flex justify-end items-center space-x-4">
                    <p class="text-[10px] text-slate-400 dark:text-slate-500 mono italic">Querying against table schema</p>
                    <button type="submit" class="btn-primary px-8 py-2.5">
                        FETCH RECORD
                        <i data-lucide="arrow-right" class="w-3.5 h-3.5 ml-2"></i>
                    </button>
                </div>
            </form>
        </div>
    </main>

    <script>
        lucide.createIcons();

        document.getElementById('form').addEventListener('submit', (e) => {
            e.preventDefault();
            const formData = new FormData(e.target);
            const values = [];

            if (formData.has('hash')) values.push(formData.get('hash'));
            if (formData.has('range')) values.push(formData.get('range'));

            const param = encodeURIComponent(values.join(','));
            window.location.href = `/tables/<%= encodeURIComponent(Table.TableName) %>/items/${param}`;
        });
    </script>
</body>

</html>
