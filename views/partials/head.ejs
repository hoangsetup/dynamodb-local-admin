<!-- Lucide Icons for consistent UI symbols -->
<script src="https://unpkg.com/lucide@latest"></script>

<script>
  function handleError(errorText) {
    const errorEl = document.querySelector('#error-wrapper');
    if (errorEl) {
      errorEl.innerHTML = '<div class="bg-red-50 dark:bg-red-900/30 border border-red-200 dark:border-red-800 text-red-800 dark:text-red-200 px-4 py-3 rounded-lg" role="alert">' + errorText + '</div>';
      errorEl.scrollIntoView({ behavior: 'smooth' });
    } else {
      window.alert(errorText);
    }
  }
</script>