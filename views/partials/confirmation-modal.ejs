<!-- Confirmation Modal -->
<div id="modal-container" class="hidden fixed inset-0 z-50 flex items-center justify-center p-4">
    <div class="absolute inset-0 bg-slate-900/70 backdrop-blur-sm" onclick="closeModal()"></div>
    <div class="bg-[#1e293b] border border-slate-700 rounded-lg shadow-2xl max-w-sm w-full relative z-10 overflow-hidden transform transition-all scale-95 opacity-0 duration-200" id="modal-box">
        <div class="bg-slate-800 px-4 py-2 border-b border-slate-700 flex justify-between items-center">
            <span class="text-[10px] font-bold text-slate-400 uppercase tracking-widest mono">System Confirmation</span>
            <button onclick="closeModal()" class="text-slate-500 hover:text-white"><i data-lucide="x" class="w-4 h-4"></i></button>
        </div>
        <div class="p-6">
            <div id="modal-icon-container" class="mb-4 text-red-400">
                <i data-lucide="alert-octagon" class="h-10 w-10"></i>
            </div>
            <h3 class="text-lg font-bold text-white mb-2" id="modal-title">EXECUTE_COMMAND?</h3>
            <p class="text-slate-400 text-xs mono leading-relaxed" id="modal-desc">This operation will modify the database schema permanently.</p>
        </div>
        <div class="flex bg-slate-900/50 p-3 space-x-2 border-t border-slate-700">
            <button onclick="closeModal()" class="flex-1 px-4 py-2 text-xs font-bold text-slate-400 hover:text-white hover:bg-slate-800 rounded transition-colors mono">
                CANCEL
            </button>
            <button id="modal-confirm-btn" class="flex-1 px-4 py-2 text-xs font-bold text-white bg-red-600 hover:bg-red-500 rounded transition-colors shadow-lg mono">
                EXECUTE
            </button>
        </div>
    </div>
</div>
